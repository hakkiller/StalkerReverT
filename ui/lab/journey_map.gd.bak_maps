# ui/lab/journey_map.gd
extends Control
class_name JourneyMap

## Путь по Зоне - объёмная топо-карта в свободном низу лаборатории.
## - Кампания: перспективная карта Зоны (сетка, туман у горизонта, маршрут к
##   Саркофагу, биконы локаций, караваны-боссы, аномалии); маркер «ВЫ» скользит
##   по тропе при шаге ◀▶ или свайпе;
## - Башня: пока лента этажей (отдельные объёмные варианты будут позже);
## - Выживание: тропа, уходящая за горизонт, с золотой отметкой рекорда.
## Всё рисуется кодом (_draw), без картинок-ассетов. Анимация через _process:
## пульс гало, шагающий огонёк, туман.
## Тач-жест: свайп по карте = шаг уровня/этажа (как кнопки ◀▶ в шапке лабы);
## в выживании шагать нечего - жест игнорируется.

signal step_requested(dir: int)   # -1 назад / +1 вперёд (свайп по карте)

const TOTAL: int = 100

const COL_PASSED := Color("49ff80")
const COL_PASSED_DIM := Color(0.286, 1.0, 0.502, 0.55)
const COL_FUTURE := Color("2c382c")
const COL_KEEPER := Color("e8b93c")
const COL_BREAK := Color("ff8d5c")
const COL_TEXT := Color("cfe0cf")
const COL_DIM := Color("8fa38c")
const COL_FAINT := Color("587059")
const COL_PANEL := Color(0.05, 0.075, 0.047, 0.92)
const COL_EDGE := Color("2c382c")

var mode: String = "campaign"   # campaign | tower | survival
var current: int = 1            # выбранный уровень/этаж
var frontier: int = 1           # открытый рубеж
var zone_label: String = ""     # глава / ярус
var record: int = 0             # рекорд волн (выживание)

var _t: float = 0.0
var _disp: float = 1.0          # плавно скользящая отображаемая позиция (для гало/огонька)
var _disp_mode: String = ""     # режим, в котором _disp последний раз синхронизировался
var _special: Dictionary = {}   # позиция -> keeper/break/boss
var _bounds: Dictionary = {}    # позиция -> true (границы глав/ярусов)
# Тач-жесты (та же схема, что в вратах ярусов)
var _press_pos: Vector2 = Vector2.ZERO
var _press_active: bool = false
var _nudge: float = 0.0         # упругий кинок карты при свайпе (0..1)
var _nudge_dir: float = 0.0     # направление кинка (+1 вправо / -1 влево)

const SWIPE_THRESHOLD := 80.0   # пикселей (дизайн-координаты) для срабатывания жеста

# ==================== ТОПО-КАРТА: ГЕОМЕТРИЯ ====================

const PERSP_K := 2.6            # сила перспективы (больше = резче сжатие к горизонту)

## Контрольные точки маршрута кампании: [уровень, u (0..1 ширина), v (0..1 глубина)]
const ROUTE: Array = [
        [0, 0.10, 0.02], [10, 0.30, 0.10], [20, 0.12, 0.20],
        [30, 0.42, 0.27], [40, 0.70, 0.20], [50, 0.84, 0.34],
        [60, 0.55, 0.44], [70, 0.80, 0.56], [80, 0.38, 0.68],
        [90, 0.64, 0.79], [100, 0.52, 0.87],
]

## Декоративные аномалии: [u, v, радиус, зелёная?]
const ANOMALIES: Array = [
        [0.26, 0.14, 60.0, false],
        [0.62, 0.30, 46.0, false],
        [0.68, 0.70, 40.0, true],
]

## Сторона подписи бикона: 0 - над биконом, +1 - вправо с лидер-линией, -1 - влево
const BEACON_SIDES: Array = [0, -1, 0, 1, 0, 1, -1, 1, -1, 1]

## Вертикальный разнос подписей биконов (разруливает тесные пары 31/61)
const BEACON_DY: Array = [0, 0, 0, 8, 0, 0, -8, 0, 0, 0]

# ==================== БАШНЯ: ЦЕПЬ ЭТАЖЕЙ («Карта долины») ====================

const CH_W := 1440.0           # дизайн-ширина цепи
const CH_H := 520.0            # дизайн-высота цепи
const CH_PER := 6              # сэмплов сплайна на сегмент

## Серпантин: вход -> нижняя полоса -> правый разворот -> средняя ->
## левый разворот -> верхняя -> хвост «до 100»
const CH_WP: Array = [
        Vector2(60, 448),
        Vector2(180, 400), Vector2(355, 400), Vector2(530, 400), Vector2(705, 400), Vector2(880, 400), Vector2(1055, 400),
        Vector2(1230, 400), Vector2(1274, 330), Vector2(1230, 268),
        Vector2(1140, 268), Vector2(965, 268), Vector2(790, 268), Vector2(615, 268), Vector2(440, 268), Vector2(265, 268),
        Vector2(73, 268), Vector2(34, 202), Vector2(73, 140),
        Vector2(180, 140), Vector2(355, 140), Vector2(530, 140), Vector2(705, 140), Vector2(880, 140), Vector2(1055, 140),
        Vector2(1240, 140),
]

## Слот узла (0..17) -> индекс точки CH_WP (18 подряд идущих этажей)
const CH_SLOT_WP: Array = [1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14, 17, 18, 19, 20, 21, 22]

var _bg_tex: Texture2D = null      # фоновая картина долины (если ассет на месте)
var _chain_built := false
var _chain_pts: Array = []         # сэмплы сплайна цепи (дизайн-координаты)
var _chain_svals: Array = []       # слотовое значение s для каждого сэмпла
var _panel_box: StyleBoxFlat       # подложка нижней панели

var _f_horizon: float = 0.0     # y линии горизонта
var _f_bottom: float = 0.0      # y ближнего края
var _f_cx: float = 0.0          # x точки схода
var _f_mapw: float = 0.0        # ширина ближнего края
var _route_pts: Array = []      # проекции уровней 0..100: Vector3(x, y, s)
var _route_key: Vector2 = Vector2(-1.0, -1.0)


func _ready() -> void:
        mouse_filter = Control.MOUSE_FILTER_STOP   # ловим свайпы по карте
        size_flags_vertical = Control.SIZE_EXPAND_FILL
        if ResourceLoader.exists("res://ui/lab/tower_chain_bg.png", "Texture2D"):
                _bg_tex = load("res://ui/lab/tower_chain_bg.png")
        _panel_box = StyleBoxFlat.new()
        _panel_box.bg_color = Color(0.016, 0.031, 0.016, 0.74)
        _panel_box.border_color = COL_EDGE
        _panel_box.set_border_width_all(1)
        _panel_box.set_corner_radius_all(8)


func _process(delta: float) -> void:
        _t += delta
        # Маркер скользит к выбранной позиции плавно (шаг ◀▶ не дёргает карту)
        _disp += (float(current) - _disp) * (1.0 - exp(-10.0 * delta))
        if _nudge > 0.0:
                _nudge = maxf(_nudge - delta * 4.5, 0.0)
        if visible:
                queue_redraw()


func _gui_input(event: InputEvent) -> void:
        # Тач на Android приходит как мышь (emulate_mouse_from_touch = true по умолчанию),
        # поэтому обрабатываем ТОЛЬКО mouse-семейство - иначе жест задвоится.
        if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
                _press_active = event.pressed
                _press_pos = event.position
                accept_event()
        elif event is InputEventMouseMotion and _press_active:
                var dx: float = event.position.x - _press_pos.x
                if absf(dx) >= SWIPE_THRESHOLD:
                        _press_pos = event.position          # продолженный драг = ещё шаг
                        _step(1 if dx < 0.0 else -1)         # свайп влево = следующий
                accept_event()


## Шаг по карте жестом (упругий кинок + сигнал наверх; шаги идут через ◀▶-обработчики)
func _step(dir: int) -> void:
        if mode == "survival":
                return   # шагать нечего: ◀▶ в выживании задизейблены
        _nudge = 1.0
        _nudge_dir = float(dir)
        step_requested.emit(dir)


# ==================== ДАННЫЕ ====================

func set_campaign(level: int, open_frontier: int, chapter: String) -> void:
        mode = "campaign"
        current = clampi(level, 1, TOTAL)
        frontier = clampi(open_frontier, 1, TOTAL)
        zone_label = chapter
        _sync_disp()
        _scan_specials()
        queue_redraw()


func set_tower(floor_num: int, open_frontier: int, tier: String) -> void:
        mode = "tower"
        current = clampi(floor_num, 1, TOTAL)
        frontier = clampi(open_frontier, 1, TOTAL)
        zone_label = tier
        _sync_disp()
        _scan_specials()
        queue_redraw()


## Мгновенный перенос маркера при смене режима или большом скачке (загрузка сейва);
## при обычных шагах ◀▶ оставляем _disp - маркер доедет плавно в _process
func _sync_disp() -> void:
        if _disp_mode != mode or absf(_disp - float(current)) > 25.0:
                _disp = float(current)
        _disp_mode = mode


func set_survival(best_wave: int) -> void:
        mode = "survival"
        record = maxi(int(best_wave), 0)
        _special.clear()
        _bounds.clear()
        queue_redraw()


func _scan_specials() -> void:
        _special.clear()
        _bounds.clear()
        if mode == "tower":
                for f in range(1, TOTAL + 1):
                        var ft: String = TowerData.get_floor_type(f)
                        if ft == "keeper":
                                _special[f] = "keeper"
                        elif ft == "break":
                                _special[f] = "break"
                        if f > 1 and (f - 1) % 10 == 0:
                                _bounds[f] = true
        else:
                var prev_chapter: String = ""
                for l in range(1, TOTAL + 1):
                        var p: Dictionary = CampaignData.get_level_params(l, CampaignData.MODE_NORMAL)
                        if bool(p.get("is_boss", false)):
                                _special[l] = "boss"
                        var ch: String = str(p.get("chapter_title", ""))
                        if prev_chapter != "" and ch != prev_chapter:
                                _bounds[l] = true
                        prev_chapter = ch


# ==================== ТОПО-КАРТА: ПОМОЩНИКИ ====================

## (u,v) маршрута для уровня (кусочный сглаженный интерполятор по ROUTE)
func _route_uv(lv: float) -> Vector2:
        var last: int = ROUTE.size() - 1
        for i in range(last):
                var l0: float = float(ROUTE[i][0])
                var l1: float = float(ROUTE[i + 1][0])
                if lv <= l1 or i == last - 1:
                        var t: float = clampf((lv - l0) / maxf(1.0, l1 - l0), 0.0, 1.0)
                        t = t * t * (3.0 - 2.0 * t)
                        var u: float = lerpf(float(ROUTE[i][1]), float(ROUTE[i + 1][1]), t)
                        var v: float = lerpf(float(ROUTE[i][2]), float(ROUTE[i + 1][2]), t)
                        return Vector2(u, v)
        return Vector2(float(ROUTE[last][1]), float(ROUTE[last][2]))


## Рамка карты под размер панели (вызывается перед проекциями)
func _topo_frame(w: float, h: float) -> void:
        var top: float = minf(96.0, h * 0.30)
        _f_bottom = h - 20.0
        _f_horizon = top + (_f_bottom - top) * 0.20
        _f_cx = w * 0.5
        _f_mapw = w * 0.88


## Проекция точки карты: x, y, масштаб глубины s (1 у ближнего края -> 0 к горизонту)
func _proj(u: float, v: float) -> Vector3:
        var s: float = (1.0 - v) / (1.0 + PERSP_K * v)
        var y: float = _f_horizon + (_f_bottom - _f_horizon) * s
        var x: float = _f_cx + (u - 0.5) * _f_mapw * s
        return Vector3(x, y, s)


## Спроецировать маршрут 0..100 (пересчёт только при смене размера панели)
func _topo_route(w: float, h: float) -> void:
        if _route_key == Vector2(w, h) and _route_pts.size() == 101:
                return
        _topo_frame(w, h)
        _route_pts.clear()
        for lv in range(101):
                var uv: Vector2 = _route_uv(float(lv))
                _route_pts.append(_proj(uv.x, uv.y))
        _route_key = Vector2(w, h)


func _chapter_name(lv: int) -> String:
        var p: Dictionary = CampaignData.get_level_params(lv, CampaignData.MODE_NORMAL)
        return String(p.get("chapter_title", "")).to_upper()


## Эллипс-контур (сжатие по Y через draw_set_transform)
func _ellipse_arc(center: Vector2, rx: float, ry: float, col: Color, width: float) -> void:
        draw_set_transform(center, 0.0, Vector2(1.0, ry / maxf(0.01, rx)))
        draw_arc(Vector2.ZERO, rx, 0.0, TAU, 40, col, width)
        draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


## Заполненный эллипс
func _ellipse_fill(center: Vector2, rx: float, ry: float, col: Color) -> void:
        draw_set_transform(center, 0.0, Vector2(1.0, ry / maxf(0.01, rx)))
        draw_circle(Vector2.ZERO, rx, col)
        draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


## Ромб (бикон/караван)
func _diamond(center: Vector2, r: float, col: Color) -> void:
        draw_colored_polygon(PackedVector2Array([
                Vector2(center.x, center.y - r), Vector2(center.x + r, center.y),
                Vector2(center.x, center.y + r), Vector2(center.x - r, center.y)]), col)


## Ширина строки моно-шрифтом
func _sw(mono: Font, txt: String, fsz: int) -> float:
        return mono.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fsz).x


## Общая местность: сетка глубины, радиальные линии, аномалии, туман у горизонта
func _draw_terrain(sc: float, slide: float) -> void:
        var w: float = size.x
        # горизонтальные линии глубины
        for i in range(16):
                var v: float = float(i) / 15.0
                var pr: Vector3 = _proj(0.5, v)
                var halfw: float = _f_mapw * pr.z * 0.5
                var a: float = 0.20 + 0.38 * pow(1.0 - v, 0.6)
                draw_line(Vector2(_f_cx - halfw + slide, pr.y), Vector2(_f_cx + halfw + slide, pr.y),
                        Color8(30, 42, 30, int(a * 255.0)), 2.0 if v < 0.35 else 1.0)
        # радиальные линии к точке схода
        for i in range(-7, 8):
                var u: float = 0.5 + float(i) / 14.0
                var p0: Vector3 = _proj(u, 0.0)
                draw_line(Vector2(p0.x + slide, p0.y), Vector2(_f_cx + slide, _f_horizon),
                        Color8(28, 40, 28, 110), 1.0)
        # аномалии (воронки)
        for an in ANOMALIES:
                var pr2: Vector3 = _proj(float(an[0]), float(an[1]))
                var rx: float = float(an[2]) * pr2.z * sc
                var ry: float = rx * 0.36
                var ac: Color = COL_PASSED if bool(an[3]) else COL_BREAK
                _ellipse_arc(Vector2(pr2.x + slide, pr2.y), rx, ry, Color(ac.r, ac.g, ac.b, 0.5), 2.0)
                _ellipse_arc(Vector2(pr2.x + slide, pr2.y), rx * 0.55, ry * 0.55, Color(ac.r, ac.g, ac.b, 0.23), 1.0)
                for k in range(12):
                        var ang: float = TAU * float(k) / 12.0
                        var ca: float = cos(ang)
                        var sa: float = sin(ang)
                        draw_line(Vector2(pr2.x + slide + ca * rx * 0.72, pr2.y + sa * ry * 0.72),
                                Vector2(pr2.x + slide + ca * rx * 1.06, pr2.y + sa * ry * 1.06),
                                Color(ac.r, ac.g, ac.b, 0.23), 1.0)
        # туман: полоса над горизонтом (гуще к линии) + мягкий подсвет ниже
        var fog_h: float = 64.0 * sc
        for i in range(12):
                var f: float = float(i + 1) / 12.0
                var yy: float = _f_horizon - fog_h + fog_h * f
                draw_rect(Rect2(0.0, yy - fog_h / 12.0, w, fog_h / 12.0 + 1.0),
                        Color(13.0 / 255.0, 19.0 / 255.0, 12.0 / 255.0, 0.6 * f * f))
        for i in range(4):
                draw_rect(Rect2(0.0, _f_horizon + 4.0 * float(i), w, 5.0),
                        Color(13.0 / 255.0, 19.0 / 255.0, 12.0 / 255.0, 0.5 - 0.12 * float(i)))


## Шагающий огонёк по пройденному пути (плавный разгон/торможение, гаснет на краях)
func _walk_light(upto: int, sc: float, slide: float, pulse: float) -> void:
        var upto_c: int = clampi(upto, 1, 100)
        var seglen: Array = []
        var total: float = 0.0
        var prev := Vector2(_route_pts[0].x, _route_pts[0].y)
        for i in range(1, upto_c + 1):
                var q := Vector2(_route_pts[i].x, _route_pts[i].y)
                total += prev.distance_to(q)
                seglen.append(total)
                prev = q
        if total <= 8.0:
                return
        var period: float = 6.0
        var k: float = fmod(_t, period) / period
        var ke: float = k * k * (3.0 - 2.0 * k)
        var fade: float = clampf(minf(k, 1.0 - k) / 0.12, 0.0, 1.0)
        var want: float = total * (0.06 + 0.94 * ke)
        var prev2 := Vector2(_route_pts[0].x, _route_pts[0].y)
        for i in range(1, upto_c + 1):
                var q2 := Vector2(_route_pts[i].x, _route_pts[i].y)
                var d0: float = 0.0 if i == 1 else float(seglen[i - 2])
                var d1: float = float(seglen[i - 1])
                if want <= d1:
                        var f: float = (want - d0) / maxf(0.001, d1 - d0)
                        var wpt: Vector2 = prev2.lerp(q2, f)
                        draw_circle(Vector2(wpt.x + slide, wpt.y), (7.0 + 2.0 * pulse) * sc,
                                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.25 * fade))
                        draw_circle(Vector2(wpt.x + slide, wpt.y), (3.5 + 1.5 * pulse) * sc,
                                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.85 * fade))
                        break
                prev2 = q2


## Маркер игрока: гало-кольца, столб, ромб, ядро, подпись
func _player_marker(mono: Font, pos: Vector3, sc: float, slide: float, pulse: float, label: String) -> void:
        var w: float = size.x
        var px: float = pos.x + slide
        for hh in [[1.0, 0.78], [1.45, 0.43], [1.95, 0.235]]:
                var rx: float = (13.0 * float(hh[0]) * pos.z + 4.0) * sc
                var ry: float = (13.0 * 0.38 * float(hh[0]) * pos.z + 2.0) * sc
                _ellipse_arc(Vector2(px, pos.y), rx, ry,
                        Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, float(hh[1]) * (0.7 + 0.3 * pulse)), 2.0)
        var bh: float = (14.0 + 46.0 * pos.z) * 1.5 * sc
        draw_line(Vector2(px, pos.y), Vector2(px, pos.y - bh), COL_PASSED, 3.0)
        _diamond(Vector2(px, pos.y - bh), 7.0 * sc, COL_PASSED)
        draw_circle(Vector2(px, pos.y - bh), (9.0 + 3.0 * pulse) * sc, Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.22))
        draw_circle(Vector2(px, pos.y - bh), 4.0 * sc, Color(0.86, 1.0, 0.9, 0.95))
        # Подпись сбоку от ромба (не над - там тесно с дальними биконами)
        var lfs: int = maxi(11, int(15.0 * sc))
        var tw: float = _sw(mono, label, lfs)
        var ty: float = pos.y - bh + 5.0 * sc
        var lx: float = px - tw - 16.0 * sc
        if lx < 8.0:
                lx = minf(px + 16.0 * sc, w - tw - 8.0)
        draw_string(mono, Vector2(lx, ty), label, HORIZONTAL_ALIGNMENT_LEFT, -1, lfs, Color(0.86, 1.0, 0.9))


# ==================== ОТРИСОВКА ====================

func _draw() -> void:
        var w := size.x
        var h := size.y
        if w < 120.0 or h < 70.0:
                return

        # Стальная панель
        draw_rect(Rect2(0, 0, w, h), COL_PANEL)
        draw_rect(Rect2(1, 1, w - 2, h - 2), COL_EDGE, false, 2.0)

        var title_font: Font = BunkerUI.font_title()
        var mono: Font = BunkerUI.font_mono()
        var pad: float = 24.0
        var sc: float = clampf(minf(w / 1440.0, h / 520.0), 0.62, 1.25)

        var title: String
        var caption: String
        match mode:
                "tower":
                        title = "БАШНЯ МОНОЛИТА"
                        caption = "ЭТАЖ %d/100 · ЯРУС «%s»" % [current, zone_label]
                "survival":
                        title = "ВЫЖИВАНИЕ"
                        caption = "РЕКОРД: %d волн" % record
                _:
                        title = "ПУТЬ К САРКОФАГУ"
                        caption = "УРОВЕНЬ %d/100 · «%s»" % [current, zone_label]
        draw_string(title_font, Vector2(pad, pad + 18), title, HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(16, int(20 * sc)), COL_TEXT)
        draw_string(mono, Vector2(w - pad - 460.0, pad + 18), caption, HORIZONTAL_ALIGNMENT_RIGHT, 460.0, maxi(11, int(14 * sc)), COL_DIM)
        # Подсказка тач-жеста (там, где есть что шагать)
        if mode != "survival":
                draw_string(mono, Vector2(pad, pad + 36), "свайп ◄ ► — шаг",
                        HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(9, int(11 * sc)), Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.85))

        # Упругий кинок карты при свайпе/шаге (затухает в _process)
        var slide: float = _nudge_dir * sin(_nudge * PI) * 10.0

        match mode:
                "campaign":
                        _draw_topo_campaign(w, h, mono, sc, slide)
                "survival":
                        _draw_topo_survival(w, h, mono, sc, slide)
                "tower":
                        if _bg_tex != null:
                                _draw_chain(w, h, mono, sc, slide)
                        else:
                                _draw_tape(w, h, pad, title_font, mono, slide)
                _:
                        _draw_tape(w, h, pad, title_font, mono, slide)


# ---------- КАМПАНИЯ: топо-карта пути к Саркофагу ----------

func _draw_topo_campaign(w: float, h: float, mono: Font, sc: float, slide: float) -> void:
        _topo_route(w, h)
        _draw_terrain(sc, slide)
        var pulse: float = 0.5 + 0.5 * sin(_t * 3.4)
        var glow: float = 0.5 + 0.5 * sin(_t * 1.6)
        var fr: int = clampi(frontier, 1, TOTAL)

        # --- будущая часть маршрута (тусклая, гаснет к горизонту) ---
        for i in range(fr, 100):
                var p1: Vector3 = _route_pts[i]
                var p2: Vector3 = _route_pts[i + 1]
                var fade: float = 1.0 - 0.5 * (float(i) / 100.0)
                draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y),
                        Color8(70, 94, 72, int(235.0 * fade)), 3.0)

        # --- пройденная часть (яркая, свечение, ширина по глубине) ---
        for i in range(fr):
                var p1: Vector3 = _route_pts[i]
                var p2: Vector3 = _route_pts[i + 1]
                var wd: float = maxf(2.0, (2.0 + 3.2 * (p1.z + p2.z) * 0.5) * sc)
                draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y),
                        Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.24), wd + 7.0 * sc)
                draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y), COL_PASSED, wd)

        # --- рубеж открытой зоны (пульсирующее кольцо на тропе) ---
        var fp: Vector3 = _route_pts[fr]
        var rr: float = (7.0 + 2.0 * pulse) * sc
        _ellipse_arc(Vector2(fp.x + slide, fp.y), rr, rr * 0.38,
                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.45 + 0.3 * pulse), 1.5)

        # --- караваны-боссы на десятках ---
        var fs_num: int = maxi(10, int(12.0 * sc))
        for lv in range(10, 101, 10):
                var p: Vector3 = _route_pts[lv]
                var is_boss: bool = str(_special.get(lv, "")) == "boss"
                var bcol: Color
                if is_boss:
                        bcol = COL_BREAK if lv <= fr else Color(COL_BREAK.r, COL_BREAK.g, COL_BREAK.b, 0.4)
                else:
                        bcol = Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.8 if lv <= fr else 0.35)
                var bob: float = sin(_t * 3.0 + float(lv) * 0.7) * 2.0 * sc
                _diamond(Vector2(p.x + slide, p.y - 12.0 * sc + bob), 7.0 * sc, bcol)
                var num: String = str(lv)
                draw_string(mono, Vector2(p.x + slide + 12.0 * sc, p.y + 16.0 * sc),
                        num, HORIZONTAL_ALIGNMENT_LEFT, -1, fs_num, COL_FAINT)

        # --- биконы локаций (старты глав: 1, 11, ... 91) ---
        var starts: Array = [1, 11, 21, 31, 41, 51, 61, 71, 81, 91]
        for bi in range(starts.size()):
                var lv: int = int(starts[bi])
                var p: Vector3 = _route_pts[lv]
                var passed_b: bool = lv <= fr
                var bcol: Color = COL_PASSED if passed_b else COL_DIM
                var hgt: float = (14.0 + 46.0 * p.z) * sc
                var bx: float = p.x + slide
                _ellipse_fill(Vector2(bx, p.y + 1.0), 9.0 * p.z * sc + 3.0, (9.0 * p.z * sc + 3.0) * 0.36, Color(0, 0, 0, 0.4))
                draw_line(Vector2(bx, p.y), Vector2(bx, p.y - hgt), Color(bcol.r, bcol.g, bcol.b, 0.8), 2.0)
                var r: float = (5.0 + 3.0 * p.z) * sc
                _diamond(Vector2(bx, p.y - hgt), r, bcol)
                # подпись: ближние - над биконом, дальние - сбоку с лидер-линией
                var nm: String = _chapter_name(lv)
                if nm.length() > 22:
                        nm = nm.substr(0, 21) + "..."
                var txt: String = "%s · %d" % [nm, lv]
                var fsz: int = clampi(int((13.0 + 9.0 * p.z) * sc), 10, int(20.0 * sc))
                if p.z < 0.5:
                        fsz = maxi(10, int(12.0 * sc))
                var side: int = int(BEACON_SIDES[bi % BEACON_SIDES.size()])
                var ty: float = p.y - hgt - r - float(fsz) - 6.0 * sc + float(BEACON_DY[bi % BEACON_DY.size()]) * sc
                var tw: float = _sw(mono, txt, fsz)
                if side == 0:
                        var tx0: float = clampf(bx - tw * 0.5, 8.0, w - tw - 8.0)
                        draw_string(mono, Vector2(tx0, ty), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fsz, bcol)
                elif side > 0:
                        draw_line(Vector2(bx + r, p.y - hgt), Vector2(bx + r + 7.0 * sc, p.y - hgt), Color(bcol.r, bcol.g, bcol.b, 0.55), 1.0)
                        var tx1: float = minf(bx + r + 10.0 * sc, w - tw - 8.0)
                        draw_string(mono, Vector2(tx1, ty + 2.0 * sc), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fsz, bcol)
                else:
                        draw_line(Vector2(bx - r, p.y - hgt), Vector2(bx - r - 7.0 * sc, p.y - hgt), Color(bcol.r, bcol.g, bcol.b, 0.55), 1.0)
                        var tx2: float = maxf(bx - r - 10.0 * sc - tw, 8.0)
                        draw_string(mono, Vector2(tx2, ty + 2.0 * sc), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fsz, bcol)

        # --- САРКОФАГ на горизонте ---
        var sp: Vector3 = _proj(0.55, 0.985)
        var sh: float = (60.0 + 26.0 * sp.z) * sc
        var sx: float = sp.x + slide
        draw_line(Vector2(sx, sp.y), Vector2(sx, sp.y - sh), Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.35), 4.0)
        var bw: float = (16.0 * sp.z + 14.0) * sc
        draw_rect(Rect2(sx - bw, sp.y - sh, bw * 2.0, sh), Color(0.05, 0.09, 0.06))
        draw_rect(Rect2(sx - bw, sp.y - sh, bw * 2.0, sh), COL_EDGE, false, 2.0)
        draw_rect(Rect2(sx - bw * 0.5, sp.y - sh + 8.0 * sc, bw, maxf(2.0, sh - 8.0 * sc)),
                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.2 + 0.25 * glow))
        var st: String = "САРКОФАГ"
        var sfs: int = maxi(10, int(13.0 * sc))
        draw_string(mono, Vector2(sx - _sw(mono, st, sfs) * 0.5, sp.y - sh - 10.0 * sc), st,
                HORIZONTAL_ALIGNMENT_LEFT, -1, sfs, COL_DIM)

        # --- шагающий огонёк по пройденному пути ---
        var disp_c: float = clampf(_disp, 1.0, 100.0)
        _walk_light(int(ceilf(disp_c)), sc, slide, pulse)

        # --- ИГРОК (скользит по тропе) ---
        var pu: Vector2 = _route_uv(disp_c)
        var pp: Vector3 = _proj(pu.x, pu.y)
        _player_marker(mono, pp, sc, slide, pulse, "ВЫ · УР. %d" % current)


# ---------- ВЫЖИВАНИЕ: тропа, уходящая за горизонт ----------

func _draw_topo_survival(w: float, h: float, mono: Font, sc: float, slide: float) -> void:
        _topo_route(w, h)
        _draw_terrain(sc, slide)
        var pulse: float = 0.5 + 0.5 * sin(_t * 3.4)

        # Рекорд -> позиция на тропе: асимптота к горизонту (10 волн ~ треть пути,
        # 50 - три четверти, дальше всегда есть куда расти)
        var rec: float = maxf(float(record), 0.0)
        var rec_lvl: float = 100.0 * rec / (rec + 18.0)

        # --- тропа: яркая до рекорда, дальше тускнеет в туман ---
        for i in range(100):
                var p1: Vector3 = _route_pts[i]
                var p2: Vector3 = _route_pts[i + 1]
                var mid: float = float(i) + 0.5
                if mid <= rec_lvl:
                        var wd: float = maxf(2.0, (2.0 + 3.2 * (p1.z + p2.z) * 0.5) * sc)
                        draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y),
                                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.24), wd + 7.0 * sc)
                        draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y), COL_PASSED, wd)
                else:
                        var fade: float = clampf(1.0 - (mid - rec_lvl) / 45.0, 0.0, 1.0) * 0.55
                        draw_line(Vector2(p1.x + slide, p1.y), Vector2(p2.x + slide, p2.y),
                                Color(COL_FUTURE.r, COL_FUTURE.g, COL_FUTURE.b, 0.25 + 0.65 * fade), 3.0)

        # --- хвост тропы за горизонт (тонет в тумане) ---
        var p100: Vector3 = _route_pts[100]
        var tail_x: float = lerpf(p100.x + slide, _f_cx + slide, 0.65)
        draw_line(Vector2(p100.x + slide, p100.y), Vector2(tail_x, _f_horizon - 2.0 * sc),
                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.18), 2.0)
        var inf: String = "БЕЗ ПРЕДЕЛА"
        var ifs: int = maxi(9, int(11.0 * sc))
        draw_string(mono, Vector2(tail_x - _sw(mono, inf, ifs) * 0.5, _f_horizon - 8.0 * sc), inf,
                HORIZONTAL_ALIGNMENT_LEFT, -1, ifs, COL_FAINT)

        # --- золотая отметка рекорда на тропе ---
        var uv_r: Vector2 = _route_uv(rec_lvl)
        var rp: Vector3 = _proj(uv_r.x, uv_r.y)
        var kcol := COL_KEEPER
        var kr: float = (9.0 + 2.5 * pulse) * sc
        _ellipse_arc(Vector2(rp.x + slide, rp.y), kr, kr * 0.38, Color(kcol.r, kcol.g, kcol.b, 0.55 + 0.3 * pulse), 2.0)
        var fh: float = 20.0 * sc
        draw_line(Vector2(rp.x + slide, rp.y), Vector2(rp.x + slide, rp.y - fh), Color(kcol.r, kcol.g, kcol.b, 0.85), 2.0)
        _diamond(Vector2(rp.x + slide, rp.y - fh), 5.5 * sc, kcol)
        var rt: String = "РЕКОРД · %d" % record
        var rfs: int = maxi(10, int(13.0 * sc))
        var rtw: float = _sw(mono, rt, rfs)
        var rtx: float = clampf(rp.x + slide - rtw * 0.5, 8.0, w - rtw - 8.0)
        draw_string(mono, Vector2(rtx, rp.y - fh - 8.0 * sc), rt, HORIZONTAL_ALIGNMENT_LEFT, -1, rfs, kcol)

        # --- шагающий огонёк до рекордной отметки ---
        _walk_light(int(ceilf(rec_lvl)), sc, slide, pulse)

        # --- ИГРОК у отметки ---
        var lbl: String = "ВЫ · ВОЛНА %d" % record
        if record <= 0:
                lbl = "ВЫ · СТАРТ"
        _player_marker(mono, rp, sc, slide, pulse, lbl)


# ---------- БАШНЯ: цепь этажей на карте долины (вариант B) ----------

## Сплайн цепи: сэмплы + слотовые значения (геометрия фиксирована, строится один раз)
func _chain_build() -> void:
        if _chain_built and _chain_pts.size() == (CH_WP.size() - 1) * CH_PER + 1:
                return
        _chain_pts.clear()
        _chain_svals.clear()
        var P: Array = [CH_WP[0]] + CH_WP + [CH_WP[CH_WP.size() - 1]]
        for i in range(1, P.size() - 2):
                var p0: Vector2 = P[i - 1]
                var p1: Vector2 = P[i]
                var p2: Vector2 = P[i + 1]
                var p3: Vector2 = P[i + 2]
                for j in range(CH_PER):
                        var t: float = float(j) / float(CH_PER)
                        var t2: float = t * t
                        var t3: float = t2 * t
                        var x: float = 0.5 * ((2.0 * p1.x) + (-p0.x + p2.x) * t + (2.0 * p0.x - 5.0 * p1.x + 4.0 * p2.x - p3.x) * t2 + (-p0.x + 3.0 * p1.x - 3.0 * p2.x + p3.x) * t3)
                        var y: float = 0.5 * ((2.0 * p1.y) + (-p0.y + p2.y) * t + (2.0 * p0.y - 5.0 * p1.y + 4.0 * p2.y - p3.y) * t2 + (-p0.y + 3.0 * p1.y - 3.0 * p2.y + p3.y) * t3)
                        _chain_pts.append(Vector2(x, y))
        _chain_pts.append(CH_WP[CH_WP.size() - 1])
        var anchors: Array = []
        for a in CH_SLOT_WP:
                anchors.append(float(a))
        for k in range(_chain_pts.size()):
                var wp_pos: float = float(k) / float(CH_PER)
                var s: float = float(anchors.size() - 2)
                var done := false
                for si in range(anchors.size() - 1):
                        if wp_pos <= anchors[si + 1]:
                                var span: float = maxf(0.0001, anchors[si + 1] - anchors[si])
                                s = float(si) + (wp_pos - anchors[si]) / span
                                done = true
                                break
                if not done:
                        var la: float = anchors[anchors.size() - 2]
                        var lb: float = anchors[anchors.size() - 1]
                        s = float(anchors.size() - 2) + (wp_pos - la) / maxf(0.0001, lb - la)
                _chain_svals.append(s)
        _chain_built = true


## Позиция узла слота s (0..17), дизайн-координаты
func _chain_node_pos(s: float) -> Vector2:
        var si: int = clampi(int(floor(s)), 0, CH_SLOT_WP.size() - 2)
        var fr: float = clampf(s, 0.0, float(CH_SLOT_WP.size() - 1)) - float(si)
        var wp_pos: float = lerpf(float(CH_SLOT_WP[si]), float(CH_SLOT_WP[si + 1]), fr)
        var idx: float = wp_pos * float(CH_PER)
        var i0: int = clampi(int(floor(idx)), 0, _chain_pts.size() - 1)
        var i1: int = mini(i0 + 1, _chain_pts.size() - 1)
        return _chain_pts[i0].lerp(_chain_pts[i1], idx - float(i0))


func _diamond_pts(c: Vector2, r: float) -> PackedVector2Array:
        return PackedVector2Array([Vector2(c.x, c.y - r), Vector2(c.x + r, c.y), Vector2(c.x, c.y + r), Vector2(c.x - r, c.y)])


## Мягкое пятно свечения (три вложенных круга)
func _chain_glow(c: Vector2, r: float, col: Color, pulse: float) -> void:
        draw_circle(c, r, Color(col.r, col.g, col.b, 0.10 + 0.08 * pulse))
        draw_circle(c, r * 0.66, Color(col.r, col.g, col.b, 0.12 + 0.10 * pulse))
        draw_circle(c, r * 0.38, Color(col.r, col.g, col.b, 0.14 + 0.10 * pulse))


## Один узел цепи: сфера или ромб-рубеж с состоянием
func _chain_node(cpos: Vector2, sc: float, vis: float, fl: int, passed_n: bool, is_cur: bool, unlocked: bool, is_mile: bool, kind: String, pulse: float, mono: Font) -> void:
        var rim: Color = COL_PASSED
        if kind == "keeper":
                rim = COL_KEEPER
        elif kind == "break":
                rim = COL_BREAK
        _ellipse_fill(cpos + Vector2(0.0, 3.0 * sc), 20.0 * sc, 7.0 * sc, Color(0, 0, 0, 0.35 * vis))
        if is_cur:
                _chain_glow(cpos, 34.0 * sc, COL_KEEPER, pulse)
                for rr in [30.0, 43.0, 56.0]:
                        draw_arc(cpos, rr * sc, 0.0, TAU, 40,
                                Color(COL_KEEPER.r, COL_KEEPER.g, COL_KEEPER.b, maxf(0.08, (0.62 - 0.13 * (rr - 30.0) / 26.0)) * (0.7 + 0.3 * pulse) * vis), 2.0)
                if is_mile:
                        var r: float = 26.0 * sc
                        _diamond(cpos, r, Color(0.26, 0.20, 0.05, vis))
                        _diamond(cpos, r * 0.52, Color(COL_KEEPER.r, COL_KEEPER.g, COL_KEEPER.b, 0.85 * vis))
                        var pl: PackedVector2Array = _diamond_pts(cpos, r)
                        pl.append(pl[0])
                        draw_polyline(pl, Color(1.0, 0.84, 0.45, vis), 3.0)
                        draw_string(mono, Vector2(cpos.x - 9.0 * sc, cpos.y + 5.5 * sc), str(fl), HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(12, int(15.0 * sc)), Color(1.0, 0.91, 0.66, vis))
                else:
                        draw_circle(cpos, 21.0 * sc, Color(0.26, 0.20, 0.05, vis))
                        draw_circle(cpos, 11.5 * sc, Color(1.0, 0.84, 0.47, 0.92 * vis))
                        draw_arc(cpos, 21.0 * sc, 0.0, TAU, 40, Color(1.0, 0.84, 0.47, vis), 3.0)
                        draw_circle(cpos + Vector2(-7.0 * sc, -8.5 * sc), 4.0 * sc, Color(1, 1, 1, 0.4 * vis))
                        draw_string(mono, Vector2(cpos.x - 10.0 * sc, cpos.y + 6.5 * sc), str(fl), HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(13, int(17.0 * sc)), Color(1.0, 0.93, 0.68, vis))
                draw_colored_polygon(PackedVector2Array([Vector2(cpos.x, cpos.y + 27.0 * sc), Vector2(cpos.x + 6.0 * sc, cpos.y + 38.0 * sc), Vector2(cpos.x - 6.0 * sc, cpos.y + 38.0 * sc)]), Color(COL_KEEPER.r, COL_KEEPER.g, COL_KEEPER.b, vis))
                var fz: int = maxi(9, int(12.0 * sc))
                draw_string(mono, Vector2(cpos.x - _sw(mono, "ВЫ ЗДЕСЬ", fz) * 0.5, cpos.y + 55.0 * sc), "ВЫ ЗДЕСЬ", HORIZONTAL_ALIGNMENT_LEFT, -1, fz, Color(1.0, 0.89, 0.55, vis))
                return
        if passed_n:
                draw_circle(cpos, 17.0 * sc, Color(0.065, 0.19, 0.10, vis))
                draw_circle(cpos, 9.5 * sc, Color(rim.r, rim.g, rim.b, 0.62 * vis))
                draw_arc(cpos, 17.0 * sc, 0.0, TAU, 32, Color(rim.r, rim.g, rim.b, vis), 2.5)
                draw_circle(cpos + Vector2(-5.5 * sc, -6.5 * sc), 3.0 * sc, Color(1, 1, 1, 0.30 * vis))
                var fs1: int = maxi(10, int(13.0 * sc))
                draw_string(mono, Vector2(cpos.x - _sw(mono, str(fl), fs1) * 0.5, cpos.y + 5.0 * sc), str(fl), HORIZONTAL_ALIGNMENT_LEFT, -1, fs1, Color(0.88, 1.0, 0.92, vis))
                draw_circle(cpos + Vector2(0.0, 25.0 * sc), 2.0 * sc, Color(rim.r, rim.g, rim.b, 0.65 * vis))
                if is_mile and vis > 0.6:
                        var fm: int = maxi(9, int(11.0 * sc))
                        draw_string(mono, Vector2(cpos.x - _sw(mono, "РУБЕЖ %d" % fl, fm) * 0.5, cpos.y - 30.0 * sc), "РУБЕЖ %d" % fl, HORIZONTAL_ALIGNMENT_LEFT, -1, fm, Color(1.0, 0.87, 0.5, 0.95 * vis))
                return
        if unlocked:
                draw_circle(cpos, 15.0 * sc, Color(0.03, 0.05, 0.03, 0.6 * vis))
                draw_arc(cpos, 15.0 * sc, 0.0, TAU, 32, Color(0.47, 0.57, 0.47, 0.9 * vis), 2.0)
                var fs2: int = maxi(9, int(12.0 * sc))
                draw_string(mono, Vector2(cpos.x - _sw(mono, str(fl), fs2) * 0.5, cpos.y + 4.5 * sc), str(fl), HORIZONTAL_ALIGNMENT_LEFT, -1, fs2, Color(COL_DIM.r, COL_DIM.g, COL_DIM.b, vis))
                if is_mile and vis > 0.6:
                        var fm2: int = maxi(9, int(11.0 * sc))
                        draw_string(mono, Vector2(cpos.x - _sw(mono, "РУБЕЖ %d" % fl, fm2) * 0.5, cpos.y - 30.0 * sc), "РУБЕЖ %d" % fl, HORIZONTAL_ALIGNMENT_LEFT, -1, fm2, Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.95 * vis))
                return
        var segs: int = 7
        var step: float = TAU / float(segs)
        for i in range(segs):
                draw_arc(cpos, 15.0 * sc, float(i) * step, float(i) * step + step * 0.72, 6, Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.8 * vis), 2.0)
        var fs3: int = maxi(9, int(12.0 * sc))
        draw_string(mono, Vector2(cpos.x - _sw(mono, str(fl), fs3) * 0.5, cpos.y + 4.5 * sc), str(fl), HORIZONTAL_ALIGNMENT_LEFT, -1, fs3, Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, vis))
        if is_mile and vis > 0.6:
                var fm3: int = maxi(9, int(11.0 * sc))
                draw_string(mono, Vector2(cpos.x - _sw(mono, "РУБЕЖ %d" % fl, fm3) * 0.5, cpos.y - 30.0 * sc), "РУБЕЖ %d" % fl, HORIZONTAL_ALIGNMENT_LEFT, -1, fm3, Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.95 * vis))


## Башня: картина долины + цепь этажей (узлы скользят «бегущей дорожкой»)
func _draw_chain(w: float, h: float, mono: Font, sc: float, slide: float) -> void:
        _chain_build()
        var pulse: float = 0.5 + 0.5 * sin(_t * 3.4)
        draw_texture_rect(_bg_tex, Rect2(0, 0, w, h), false)
        var ox: float = (w - CH_W * sc) * 0.5 + slide
        var oy: float = (h - CH_H * sc) * 0.5
        var cur_f: int = clampi(int(roundf(_disp)), 1, TOTAL)
        var win: float = clampf(_disp - 9.0, 1.0, 91.0)   # этаж в слоте 0
        var p: float = _disp - win                        # слот маркера (обычно 9)
        var fr_s: float = float(frontier) - win           # слот открытого рубежа

        # --- дорога: два прохода (свечение/ядро), цвет по слоту ---
        var n_s: int = _chain_pts.size()
        for pass_i in range(2):
                var k: int = 0
                while k < n_s - 1:
                        var sm: float = (_chain_svals[k] + _chain_svals[k + 1]) * 0.5
                        var a: Vector2 = Vector2(ox + _chain_pts[k].x * sc, oy + _chain_pts[k].y * sc)
                        var b: Vector2 = Vector2(ox + _chain_pts[k + 1].x * sc, oy + _chain_pts[k + 1].y * sc)
                        if sm < p:
                                if pass_i == 0:
                                        draw_line(a, b, Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.20), 13.0 * sc)
                                else:
                                        draw_line(a, b, COL_PASSED, 4.5 * sc)
                        elif sm <= p + 1.0:
                                if pass_i == 0:
                                        draw_line(a, b, Color(COL_KEEPER.r, COL_KEEPER.g, COL_KEEPER.b, 0.18), 13.0 * sc)
                                else:
                                        draw_line(a, b, Color(COL_KEEPER.r, COL_KEEPER.g, COL_KEEPER.b, 0.85), 4.5 * sc)
                        elif sm <= fr_s:
                                if pass_i == 1:
                                        draw_line(a, b, Color8(112, 140, 112, 215), 3.0 * sc)
                        elif pass_i == 1 and k % 2 == 0:
                                draw_line(a, b, Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.75), 2.0 * sc)
                        k += 1

        # --- узлы этажей (скользят при шаге) ---
        var f0: int = maxi(1, int(floor(win)) - 1)
        var f1: int = mini(TOTAL, int(ceil(win)) + 20)
        for fcur in range(f0, f1 + 1):
                var s: float = float(fcur) - win
                var vis: float = clampf(minf((s + 0.45) / 0.85, (17.55 - s) / 0.75), 0.0, 1.0)
                if vis <= 0.001:
                        continue
                var pos: Vector2 = _chain_node_pos(clampf(s, 0.0, 17.0))
                var cpos := Vector2(ox + pos.x * sc, oy + pos.y * sc)
                _chain_node(cpos, sc, vis, fcur, fcur < cur_f, fcur == cur_f, fcur <= frontier,
                        fcur % 10 == 0, str(_special.get(fcur, "")), pulse, mono)

        # --- декор входа и хвоста ---
        if win < 10.0:
                draw_string(mono, Vector2(ox + 44.0 * sc, oy + 456.0 * sc), "ВХОД", HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(8, int(11.0 * sc)), Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.9))
        if win + 18.0 < 99.0:
                draw_string(mono, Vector2(ox + 1252.0 * sc, oy + 130.0 * sc), "···", HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(10, int(15.0 * sc)), Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.9))
                draw_string(mono, Vector2(ox + 1276.0 * sc, oy + 164.0 * sc), "до 100", HORIZONTAL_ALIGNMENT_LEFT, -1, maxi(8, int(11.0 * sc)), Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.85))

        # --- нижняя панель: рубежи, прогресс, этаж ---
        var pb := Rect2(ox + 756.0 * sc, oy + 452.0 * sc, 658.0 * sc, 50.0 * sc)
        draw_style_box(_panel_box, pb)
        var fs_p: int = maxi(9, int(13.0 * sc))
        draw_string(mono, Vector2(pb.position.x + 24.0 * sc, pb.position.y + 31.0 * sc),
                "РУБЕЖИ ОТКРЫТО · %d/10" % clampi(frontier / 10, 0, 10), HORIZONTAL_ALIGNMENT_LEFT, -1, fs_p, Color(0.88, 0.93, 0.87))
        var bar := Rect2(pb.position.x + 268.0 * sc, pb.position.y + 20.0 * sc, 200.0 * sc, 10.0 * sc)
        draw_rect(bar, Color(0.14, 0.20, 0.14, 0.9), true)
        var fillw: float = bar.size.x * float(cur_f) / 100.0
        if fillw > 1.0:
                draw_rect(Rect2(bar.position, Vector2(fillw, bar.size.y)), COL_KEEPER, true)
        draw_rect(bar, Color(COL_EDGE.r, COL_EDGE.g, COL_EDGE.b, 0.9), false, 1.0)
        var cap: String = "ЭТАЖ %d/100" % cur_f
        draw_string(mono, Vector2(pb.position.x + pb.size.x - 24.0 * sc - _sw(mono, cap, fs_p), pb.position.y + 31.0 * sc), cap, HORIZONTAL_ALIGNMENT_LEFT, -1, fs_p, Color(0.85, 0.9, 0.84))


# ---------- БАШНЯ: лента этажей (временная, до выбора объёмного варианта) ----------

func _draw_tape(w: float, h: float, pad: float, title_font: Font, mono: Font, slide: float) -> void:
        var pulse: float = 0.5 + 0.5 * sin(_t * 3.4)
        var glow: float = 0.6 + 0.4 * sin(_t * 1.6)
        var map_left: float = pad + 8.0 + slide
        var map_right: float = w - pad - 78.0 + slide
        var base_y: float = h - 36.0
        var area_top: float = pad + 34.0
        var map_w: float = maxf(120.0, map_right - map_left)
        var slot: float = map_w / float(TOTAL)
        var tick_w: float = maxf(3.0, slot - 1.5)
        var map_h: float = maxf(60.0, base_y - area_top)
        var th_base: float = clampf(map_h * 0.30, 18.0, 92.0)

        # Границы ярусов
        for b in _bounds:
                var bx: float = map_left + (float(b) - 0.5) * slot
                draw_line(Vector2(bx, area_top), Vector2(bx, base_y + 8.0), Color(COL_FAINT.r, COL_FAINT.g, COL_FAINT.b, 0.55), 1.0)

        # Тики этажей (подсветка следует за скользящим маркером _disp)
        var cur_i: int = clampi(int(roundf(_disp)), 1, TOTAL)
        var cur_x: float = map_left + (_disp - 0.5) * slot - tick_w * 0.5
        for i in range(1, TOTAL + 1):
                var x: float = map_left + (float(i) - 0.5) * slot - tick_w * 0.5
                var kind: String = str(_special.get(i, ""))
                var th: float = th_base
                var col: Color = COL_FUTURE
                if i < frontier:
                        col = COL_PASSED_DIM
                var scol: Color = COL_KEEPER if kind == "keeper" else COL_BREAK
                if kind == "keeper":
                        th = th_base * 1.65
                        col = scol if i <= frontier else Color(scol.r, scol.g, scol.b, 0.30)
                elif kind == "break":
                        th = th_base * 1.3
                        col = scol if i <= frontier else Color(scol.r, scol.g, scol.b, 0.30)
                if i == cur_i:
                        th = maxf(th, th_base * 1.35)
                        draw_rect(Rect2(cur_x - 2.0, base_y - th - 8.0 - 6.0 * pulse, tick_w + 4.0, th + 8.0 + 6.0 * pulse),
                                Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.08 + 0.10 * pulse))
                        col = COL_PASSED.lerp(Color(1, 1, 1), 0.20 + 0.20 * pulse)
                elif i == frontier:
                        th = maxf(th, th_base * 1.15)
                draw_rect(Rect2(x, base_y - th, tick_w, th), col)
                if i == frontier and i != cur_i:
                        draw_rect(Rect2(x - 1.0, base_y - th - 3.0, tick_w + 2.0, th + 3.0), COL_PASSED, false, 1.5)

        # Базовая линия
        draw_line(Vector2(map_left - 6.0, base_y), Vector2(map_right + 6.0, base_y), COL_EDGE, 2.0)

        # Шагающий огонёк по ленте
        var target_x: float = map_left + (_disp - 0.5) * slot
        var span: float = target_x - map_left
        if span > 8.0:
                var period: float = 6.0
                var k: float = fmod(_t, period) / period
                var ke: float = k * k * (3.0 - 2.0 * k)
                var fade: float = clampf(minf(k, 1.0 - k) / 0.12, 0.0, 1.0)
                var walker_x: float = map_left + span * (0.06 + 0.94 * ke)
                draw_line(Vector2(walker_x - 16.0, base_y - 5.0), Vector2(walker_x, base_y - 5.0),
                        Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.30 * fade), 2.0)
                draw_circle(Vector2(walker_x, base_y - 5.0), 3.5 + 1.5 * pulse, Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, fade))

        # Подписи десятков
        for i in range(10, TOTAL + 1, 10):
                var lx: float = map_left + (float(i) - 0.5) * slot
                draw_string(mono, Vector2(lx - 16.0, base_y + 18), str(i), HORIZONTAL_ALIGNMENT_CENTER, 32, 11, COL_FAINT)
        draw_string(mono, Vector2(map_left - 16.0, base_y + 18), "1", HORIZONTAL_ALIGNMENT_CENTER, 32, 11, COL_FAINT)

        # Монолит: шпиль
        var gx: float = map_right + 34.0
        var spike_h: float = clampf(th_base * 1.9, 46.0, 130.0)
        var spike := PackedVector2Array([Vector2(gx, base_y - spike_h), Vector2(gx + 12.0, base_y), Vector2(gx - 12.0, base_y)])
        draw_colored_polygon(spike, Color(0.10, 0.14, 0.10))
        draw_line(Vector2(gx, base_y - spike_h), Vector2(gx, base_y), Color(COL_PASSED.r, COL_PASSED.g, COL_PASSED.b, 0.30 + 0.35 * glow), 2.0)
        draw_string(mono, Vector2(gx - 42.0, base_y + 18), "МОНОЛИТ", HORIZONTAL_ALIGNMENT_CENTER, 84, 10, COL_DIM)
