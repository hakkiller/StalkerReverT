# ui/onboarding/story.gd
extends RefCounted
class_name Story

## Сюжет онбординга. Формат строки: {"who": "ИМЯ", "text": "..."}.
## Персонажи:
##   ПРОВОДНИК  -campaign- бывалый ходок, ведёт к Саркофагу (скрывает прошлое)
##   ДИСПЕТЧЕР  -выживание- голос арены на радиочастоте
##   СТАРОЖИЛ   -башня- хранитель врат ярусов
## Кампания: вводная + диалог при входе в каждую новую главу (между этапами).

const C_GUIDE := "ПРОВОДНИК"
const C_DISP := "ДИСПЕТЧЕР"
const C_ELDER := "СТАРОЖИЛ"


static func _g(text: String) -> Dictionary:
        return {"who": C_GUIDE, "text": text}


static func _d(text: String) -> Dictionary:
        return {"who": C_DISP, "text": text}


static func _e(text: String) -> Dictionary:
        return {"who": C_ELDER, "text": text}


# ==================== КАМПАНИЯ ====================

static func camp_intro() -> Array:
        return [
                _g("Ну, здравствуй, лаборант. Зона тебя приняла — а значит, у тебя есть шанс."),
                _g("Смотри на карту: сто колец до Саркофага. Каждый забег — кольцо ближе. Я проведу."),
                _g("Сталкеры попрут за артефактами — не пусти. Аномалии ставь умнее, мутантов корми сытнее."),
                _g("Первая глава — «Тропы новичков». Тут даже дурак выживает. Но ты — не дурак. Иди."),
        ]


static func chapter_intro(chapter_idx: int, title: String) -> Array:
        var tail := [
                _g("Дальше будет хуже. И интереснее. Держи хребет прямо."),
        ]
        match chapter_idx:
                1:
                        return [
                                _g("Вторая глава — «%s». Сталкеры уже знают: у этой лабы зубы есть." % title),
                                _g("Теперь они пойдут не по одному, а звеньями. Периметр держи плотным."),
                                _g("И слушай Зону. Если затихла — жди беды. Если поёт — беда уже здесь."),
                        ]
                2:
                        return [
                                _g("«%s»... Мутанты начали ходить стаями. Так не бывает — если бы кто-то их не вёл." % title),
                                _g("Ловушки на тропах, засады в тумане. Ставь аномалии друг за другом — волнами."),
                                _g("Кто-то очень хочет, чтобы ты открыл Саркофаг. Или чтобы ты его не открыл. Разберёмся."),
                        ]
                3:
                        return [
                                _g("«%s». Здесь шли караваны. Ни один не дошёл." % title),
                                _g("Ржавые телеги, догорающие костры... Тут воет не ветер, тут воет то, что осталось от людей."),
                                _g("Я хожу в Зоне двадцать лет. Впервые мне не нравится дорога."),
                        ]
                4:
                        return [
                                _g("«%s». Дождь выжигает всё живое. Даже у меня зубы сводит." % title),
                                _g("Саркофаг отсюда виден: светится, как глаз. И смотрит он, лаборант, похоже, на тебя."),
                                _g("Собери всех мутантов под руку. Дождь пройдёт — сталкеры придут."),
                        ]
                5:
                        return [
                                _g("«%s»... Тёмная долина. Я знал одного ходока, который тут пропал. Это был... мой брат." % title),
                                _g("Зона забирает тех, кто идёт на свет. А мы идём на самый яркий свет в мире."),
                                _g("Не слушай, если что-то позовёт твоим голосом. Это не ты."),
                        ]
                6:
                        return [
                                _g("«%s». Маршруты меняются на глазах. Я веду вслепую — впервые за двадцать лет." % title),
                                _g("Знаешь что? Хватит тайн. Я был учёным в Саркофаге. Я сбежал. Зона меня не отпустила."),
                                _g("Дойдем — я выключу эту перезвонницу. Навсегда. Доверь мне последний переход."),
                        ]
                7:
                        return [
                                _g("«%s». Земля здесь выжжена до стекла. Кольца мёртвые — даже трава не врёт." % title),
                                _g("Я должен тебе правду: я не сбежал. Меня выгнали. Я хотел отключить Саркофаг — а он хотел, чтобы я остался."),
                                _g("Ещё немного, лаборант. Я почти слышу его песню. А значит — мы почти на месте."),
                        ]
                8:
                        return [
                                _g("«%s». Дальше земли монолитовцев. Они молятся тому, что мы пришли выключить." % title),
                                _g("Не смотри в глаза их знамёнам. Не слушай их пение. Просто держи рубеж."),
                                _g("Если я начну повторять их слова — стреляй в меня. Шучу. Наверное."),
                        ]
                9:
                        return [
                                _g("«%s». Последний рубеж, лаборант. За ним — Саркофаг. За ним — вся правда." % title),
                                _g("Я слышу его зов яснее, чем твой голос. Это плохой знак. Или хороший — не знаю."),
                                _g("Ставь всё, что есть. Они пойдут стеной. А я... я в последний раз пройду свою тропу."),
                                _g("Дойди до конца. И помни: Зона — это не место. Зона — это выбор. Сделай свой."),
                        ]
        return tail


# ==================== ВЫЖИВАНИЕ (АРЕНА) ====================

static func surv_intro() -> Array:
        return [
                _d("На приёме, новичок. Добро пожаловать на Арену выживания — здесь Зона меряет, сколько ты стоишь."),
                _d("Волны идут без предела. Десятая, двадцатая, пятидесятая — каждый рубеж твой, если доживёшь."),
                _d("Твой рекорд пишется в профиль. Соперники будут вызывать тебя, а ты — их. Ставь оборону: отряд защиты отобьёт чужие вызовы, пока ты в забеге."),
                _d("Сезон кончится — награды раздадут по местам. А пока правило одно: держись дольше вчерашнего. Конец связи."),
        ]


# ==================== БАШНЯ ====================

static func tower_intro() -> Array:
        return [
                _e("Врата ярусов... Открыто было сто лет до тебя и будет открыто сто лет после. Заходи."),
                _e("Башня Монолита: этаж за этажом, до самого неба. Каждый этаж — свой устав: свои волны, свои дары."),
                _e("Пройдёшь этаж — получишь звёзды. Три звезды — крутки сверх меры. Выше ярус — богаче сундук."),
                _e("И запомни, пришедший: башня не убивает. Башня спрашивает. Отвечай делом. Поднимайся."),
        ]
